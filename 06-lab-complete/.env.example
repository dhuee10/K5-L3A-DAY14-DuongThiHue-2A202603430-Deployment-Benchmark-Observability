# ============================================================
# Biến môi trường của agent. KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore)
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
WEB_CONCURRENCY=2

# Security — đặt giá trị thật trong .env hoặc trên platform (Railway/Render)
AGENT_API_KEY=change-me

# State store (rate limit, cost, history)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request / 60 giây / API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD)
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0

# Conversation history: số message giữ lại cho mỗi user
HISTORY_MAX_MESSAGES=20
